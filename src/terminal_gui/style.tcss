StateLabel {
    height: 3;
    margin: 0;
    min-width: 20;
    padding: 1;
    text-align: center;
    text-style: bold;
    color: white;
}

Tabs Tab {
        width: 50%;
}

DeviceInfoPanel {
    background: rgb(1, 54, 95);
    height: 3
}

.device_details_label {
    height: 1;
    margin: 0;
    min-width: 20;
    padding: 0;
    padding-left: 3;
    text-align: left;
    text-style: bold;
    background: transparent;
    color: white;
}

.pass {
    background: green;
}

.fail {
    background: red;
}

.running {
    background: orange;
}

.waiting {
    background: gray;
}
